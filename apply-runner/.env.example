# Copy to .env and fill in. .env is gitignored.

# Anthropic API key for browser-use's own agent loop.
# NOTE: this is a console.anthropic.com API key and bills per token,
# separately from any Claude Code / Claude subscription.
ANTHROPIC_API_KEY=

# Model browser-use drives the browser with.
BROWSER_USE_MODEL=claude-sonnet-5

# Where the career-ops checkout lives. Deliberately NOT named
# CAREER_OPS_ROOT — career-ops already uses that name for its data
# directory, and reusing it would collide.
CAREER_OPS_REPO=../../career-ops

# browser-use ships anonymized telemetry on by default. This handles
# a real person's job applications, so it is off here.
ANONYMIZED_TELEMETRY=false
